# Copy to .env and edit
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/od_leave_system
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Minutes ahead of UTC for your campus (India = 330). Used to work out which calendar days an OD covers.
TZ_OFFSET_MIN=330
# Email for verification codes and password reset.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter App Password>
# Leave SMTP_HOST empty in development: emails (with the code) are printed in the server terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusOD <no-reply@campus.edu>"
